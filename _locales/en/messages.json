                "example": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
            }
        }
    },
    "script_unimplemented_node": {
        "description": "Called by the content script in the event of developer error",
        "message": "Node of type $node_type$ is marked as supported, but no implementation exists. Skipping addition of node. Any anomalous parent updates associated with id $node_id$ are the result of this.",
        "placeholders": {
            "node_type": {
                "description": "The numeric node type",
                "content": "$1",
                "example": "2"
            },
