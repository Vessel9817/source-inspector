{
    "ext_name": {
        "description": "The extension name",
        "message": "Source Inspector"
    },
    "ext_description": {
        "description": "The extension description",
        "message": "An open-source document source inspector that aims to be invisible to websites"
    },
    "ext_author": {
        "description": "The extension author's name",
        "message": "Vessel9817"
    },
    "script_disconnected": {
        "description": "Called by the popup when the content script connection severs",
        "message": "Disconnected from tab!"
    },
    "script_connected": {
        "description": "Called by the content script",
        "message": "Successfully connected to popup!"
    },
    "popup_disconnected": {
        "description": "Called by the content script when the connection severs",
        "message": "Disconnected from popup!"
    },
    "bg_connecting": {
        "description": "Called by the background script",
        "message": "Connecting popup to tab..."
    },
    "bg_registered": {
        "description": "Called by the background script after initialization",
        "message": "Registering complete!"
    },
    "bg_script_initialized": {
        "description": "Called by the background script",
        "message": "Tab $tab_id$ successfully initialized!",
        "placeholders": {
            "tab_id": {
                "description": "The unique tab identifier",
                "content": "$1",
                "example": "12"
            }
        }
    },
    "bg_popup_initialized": {
        "description": "Called by the background script",
        "message": "Popup $popup_id$ successfully initialized!",
        "placeholders": {
            "popup_id": {
                "description": "The unique popup identifier",
                "content": "$1",
                "example": "12"
            }
        }
    },
    "bg_script_timeout": {
        "description": "Called by the background script",
        "message": "Tab $tab_id$ failed to connect within $timeout$ms",
        "placeholders": {
            "tab_id": {
                "description": "The unique tab identifier",
                "content": "$1",
                "example": "12"
            },
            "timeout": {
                "description": "The timeout, in milliseconds",
                "content": "$2",
                "example": "5000"
            }
        }
    },
    "bg_popup_timeout": {
        "description": "Called by the background script",
        "message": "Popup $popup_id$ failed to connect within $timeout$ms",
        "placeholders": {
            "popup_id": {
                "description": "The unique popup identifier",
                "content": "$1",
                "example": "12"
            },
            "timeout": {
                "description": "The timeout, in milliseconds",
                "content": "$2",
                "example": "5000"
            }
        }
    },
    "renderer_unknown": {
        "description": "Called by the popup",
        "message": "Couldn't render unknown node of id: $node_id$",
        "placeholders": {
            "node_id": {
                "description": "The unique node debug identifier",
                "content": "$1",
                "example": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
            }
        }
    },
    "script_char_mutation": {
        "description": "Debug message from the content script",
        "message": "Character data mutation on node $node_id$:",
        "placeholders": {
            "node_id": {
                "description": "The unique node debug identifier",
                "content": "$1",
                "example": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
            }
        }
    },
    "script_invalid_attr": {
        "description": "Called by the content script",
