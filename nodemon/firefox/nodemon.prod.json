{
    "exec": "npx ts-node webpack/webserver.ts",
    "verbose": true,
    "ignore": [
        "/dist",
        "/coverage",
        "/.vscode",
        "/.git",
        "/wepack",
        "/test",
        "/.github",
        "/nodemon"
    ],
    "watch": [
        "./webpack/webserver.ts",
        "./webpack/webpack.config.ts",
        "./src/react-app-env.d.ts",
        "./package-lock.json",
        "tsconfig.json"
    ],
    "env": {
        "NODE_ENV": "production",
        "ASSET_PATH": "/",
        "OUTPUT_DIR": "dist/firefox/prod",
        "BROWSER": "firefox",
        "PACKAGE_NAME": "source-inspector",
        "PACKAGE_DESCRIPTION": "A from-scratch open-source document source inspector that aims to be invisible to websites",
        "WEBPACK_PORT": "8083"
    },
    "ext": "json,cjs,mjs,js,ts"
}
