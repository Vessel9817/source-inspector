{
    "$schema": "https://www.schemastore.org/nodemon.json",
    "exec": "node --run=start-helper",
    "verbose": true,
    "ignore": [
        "**/dist/**",
        "**/node_modules/**",
        "**/coverage/**",
        "**/.idea/**",
        "**/.vs/**",
        "**/.vscode/**",
        "**/.git/**",
        "**/test/**",
        "**/.github/**",
        "**/nodemon/**"
    ],
    "watch": [
        "./webpack/",
        "./src/globals.d.ts",
        "./src/react-app-env.d.ts",
        "./package.json",
        "./package-lock.json",
        "./tsconfig.*"
    ],
    "env": {
        "NODE_ENV": "development",
        "OUTPUT_DIR": "dist/firefox/dev",
        "BROWSER": "firefox",
        "DEFAULT_LOCALE": "en",
        "PACKAGE_VERSION": "1.0.0",
        "PACKAGE_URL": "https://github.com/Vessel9817/source-inspector",
        "PACKAGE_AUTHOR": "Vessel9817",
        "WEBPACK_PORT": "0"
    },
    "ext": "json,cjs,mjs,js,ts"
}
