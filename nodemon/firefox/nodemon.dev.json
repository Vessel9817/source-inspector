{
    "$schema": "https://www.schemastore.org/nodemon.json",
    "exec": "node --run=start-helper",
    "verbose": true,
    "ignore": [
        "/dist",
        "/coverage",
        "/.vscode",
        "/.git",
        "/test",
        "/.github",
        "/nodemon"
    ],
    "watch": [
        "./webpack/",
        "./src/react-app-env.d.ts",
        "./package.json",
        "./package-lock.json",
        "tsconfig.json"
    ],
    "env": {
        "NODE_ENV": "development",
        "OUTPUT_DIR": "dist/firefox/dev",
        "BROWSER": "firefox",
        "PACKAGE_NAME": "(DEV BRANCH) source-inspector",
        "PACKAGE_DESCRIPTION": "DEVELOPER USE ONLY - DO NOT PUBLISH",
        "PACKAGE_VERSION": "1.0.0",
        "PACKAGE_URL": "https://github.com/Vessel9817/source-inspector",
        "PACKAGE_AUTHOR": "Vessel9817",
        "WEBPACK_PORT": "8082"
    },
    "ext": "json,cjs,mjs,js,ts"
}
