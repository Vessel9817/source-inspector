{
    "exec": "npx ts-node webpack/webserver.ts",
    "verbose": true,
    "ignore": [
        "/dist",
        "/coverage",
        "/.vscode",
        "/.git",
        "/test",
        "/.github",
        "/nodemon"
    ],
    "watch": [
        "./webpack/",
        "./src/react-app-env.d.ts",
        "./package.json",
        "./package-lock.json",
        "tsconfig.json"
    ],
    "env": {
        "NODE_ENV": "development",
        "ASSET_PATH": "/",
        "OUTPUT_DIR": "dist/firefox/dev",
        "BROWSER": "firefox",
        "PACKAGE_NAME": "(DEV BRANCH) source-inspector",
        "PACKAGE_DESCRIPTION": "DEVELOPER USE ONLY - DO NOT PUBLISH",
        "PACKAGE_VERSION": "1.0.0",
        "PACKAGE_URL": "https://github.com/Anonymous-Humanoid/source-inspector",
        "PACKAGE_AUTHOR": "Anonymous-Humanoid",
        "WEBPACK_PORT": "8082"
    },
    "ext": "json,cjs,mjs,js,ts"
}
