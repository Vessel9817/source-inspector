{
    "name": "source-inspector",
    "version": "1.0.0",
    "description": "A from-scratch open-source document source inspector that aims to be invisible to websites",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Anonymous-Humanoid/source-inspector.git"
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start:chrome:dev": "nodemon --config nodemon/chrome/nodemon.dev.json",
        "start:firefox:dev": "nodemon --config nodemon/firefox/nodemon.dev.json",
        "start:chrome:prod": "nodemon --config nodemon/chrome/nodemon.prod.json",
        "start:firefox:prod": "nodemon --config nodemon/firefox/nodemon.prod.json",
        "prettier": "prettier --write **/*.{cjs,mjs,js,jsx,ts,tsx,json,css,scss,html} --config .prettierrc --ignore-path .prettierignore",
        "tsc": "tsc --noEmit"
    },
    "dependencies": {
        "assert": "^2.1.0",
        "async-mutex": "^0.5.0",
        "process": "^0.11.10",
        "react": "^19.2.0",
        "react-dom": "^19.1.1",
        "uuid": "^14.0.0"
    },
    "devDependencies": {
        "@types/chrome": "^0.2.2",
        "@types/firefox-webext-browser": "^143.0.0",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.1.9",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.2",
        "eslint-plugin-jsx-a11y": "^6.7.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "html-loader": "^4.2.0",
        "html-webpack-plugin": "^5.6.4",
        "nodemon": "^3.1.9",
        "prettier": "^2.8.3",
        "sass": "^1.93.2",
        "sass-loader": "^13.2.0",
        "source-map-loader": "^5.0.0",
        "style-loader": "^4.0.0",
        "tapable": "^2.3.0",
        "terser-webpack-plugin": "^5.3.14",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "type-fest": "^5.0.1",
        "typescript": "^6.0.3",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2",
        "webpack-dev-server": "^5.0.4",
        "webpack-sources": "^3.3.3"
    }
}
