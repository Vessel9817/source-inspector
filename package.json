{
    "name": "source-inspector",
    "version": "1.0.0",
    "description": "A from-scratch open-source document source inspector that aims to be invisible to websites",
    "license": "MIT",
    "type": "module",
    "sideEffects": true,
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vessel9817/source-inspector.git"
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "tsx webpack/cli.ts build",
        "start-helper": "tsx webpack/webserver.ts",
        "start:chrome:dev": "nodemon --config nodemon/chrome/nodemon.dev.json",
        "start:firefox:dev": "nodemon --config nodemon/firefox/nodemon.dev.json",
        "start:chrome:prod": "nodemon --config nodemon/chrome/nodemon.prod.json",
        "start:firefox:prod": "nodemon --config nodemon/firefox/nodemon.prod.json",
        "tsc": "tsc --noEmit"
    },
    "dependencies": {
        "assert": "^2.1.0",
        "async-mutex": "^0.5.0",
        "process": "^0.11.10",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@types/chrome": "^0.2.5",
        "@types/firefox-webext-browser": "^143.0.0",
        "@types/mini-css-extract-plugin": "^2.5.0",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "commander": "^15.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.4",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.8",
        "mini-css-extract-plugin": "^2.10.2",
        "nodemon": "^3.1.14",
        "postcss": "^8.5.25",
        "postcss-loader": "^8.2.1",
        "sanitize-filename": "^1.6.4",
        "sass": "^1.102.0",
        "sass-loader": "^17.0.0",
        "source-map": "^0.8.0",
        "source-map-loader": "^5.0.0",
        "style-loader": "^4.0.0",
        "tapable": "^2.3.3",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.6.2",
        "tsx": "^4.23.5",
        "typescript": "^6.0.3",
        "webpack": "^5.109.2",
        "webpack-dev-server": "^6.0.0",
        "webpack-sources": "^3.5.1"
    }
}
