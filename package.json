{
    "name": "source-inspector",
    "version": "1.0.0",
    "description": "A from-scratch open-source document source inspector that aims to be invisible to websites",
    "license": "MIT",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vessel9817/source-inspector.git"
    },
    "scripts": {
        "test": "tsx --experimental-test-module-mocks --test \"test/**/*.spec.ts\"",
        "build": "tsx webpack/cli/index.ts build",
        "start-helper": "tsx webpack/server/index.ts",
        "start:chrome:dev": "nodemon --config nodemon/chrome/nodemon.dev.json",
        "start:firefox:dev": "nodemon --config nodemon/firefox/nodemon.dev.json",
        "start:chrome:prod": "nodemon --config nodemon/chrome/nodemon.prod.json",
        "start:firefox:prod": "nodemon --config nodemon/firefox/nodemon.prod.json",
        "tsc": "tsc"
    },
    "dependencies": {
        "@fvilers/disable-react-devtools": "^1.3.0",
        "assert": "^2.1.0",
        "async-mutex": "^0.5.0",
        "process": "^0.11.10",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "@types/chrome": "^0.3.0",
        "@types/firefox-webext-browser": "^143.0.0",
        "@types/node": "^26.6.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/semver": "^7.8.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "commander": "^15.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "fork-ts-checker-webpack-plugin": "^9.1.0",
        "jsonc-parser": "^3.3.1",
        "nodemon": "^3.1.14",
        "path-sanitizer": "^4.0.2",
        "sanitize-filename": "^1.6.4",
        "semver": "^7.8.5",
        "source-map": "^0.8.0",
        "source-map-loader": "^5.0.0",
        "tapable": "^2.3.3",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.6.2",
        "tsx": "^4.23.13",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "webpack": "^5.111.0",
        "webpack-dev-server": "^6.0.0",
        "webpack-sources": "^3.5.1",
        "yaml": "^2.9.1"
    }
}
